# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
# production only (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# Database — Postgres by default; DB_ENGINE=sqlite for a quick local run
DB_ENGINE=postgres
# PostgreSQL — docker-compose overrides POSTGRES_HOST/REDIS_URL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bagymo
POSTGRES_USER=bagymo
POSTGRES_PASSWORD=bagymo123

# Redis (cache + celery). Leave empty to use an in-memory cache in dev.
REDIS_URL=redis://127.0.0.1:6379/1
# set to false in production when a celery worker is running
CELERY_EAGER=true

# Auth
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# SMS (Kavenegar) - sandbox
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Payments (Iran-only providers)
ZARINPAL_MERCHANT_ID=
IDPAY_PIN=
IDPAY_USEDOMAIN=false

# Maps (Neshan)
# Neshan Search API key — a "service" key (service.…) from platform.neshan.org, used by
# `manage.py sync_neshan_venues`. The Search service must be enabled by Neshan support (ticket).
NESHAN_API_KEY=
NESHAN_SEARCH_BASE_URL=https://api.neshan.org/

# nightly venue sync via celery beat (needs the celery-worker + celery-beat services)
VENUE_SYNC_ENABLED=true
VENUE_SYNC_CITIES=tehran
VENUE_SYNC_GRID=3
VENUE_SYNC_SPACING_KM=8
VENUE_SYNC_HOUR=3

# Optional contact details shown on the public /contact page (frontend build-time)
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
